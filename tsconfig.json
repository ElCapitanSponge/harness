{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "noEmit": true,
    "paths": {
      "@harness/core": ["./packages/core/src/index.ts"],
      "@harness/tools": ["./packages/tools/src/index.ts"],
      "@harness/claude": ["./packages/claude/src/index.ts"],
      "@harness/lmstudio": ["./packages/lmstudio/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "scripts/**/*.ts", "eslint.config.ts"]
}
