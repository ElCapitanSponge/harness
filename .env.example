# Copy to .env (git-ignored). Read by `pnpm gateway`, `pnpm agent` and `pnpm harness`.

# Shared secret. Required whenever the gateway listens on anything but loopback.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HARNESS_API_KEY=

# Comma-separated listen addresses. "tailscale" means this machine's Tailscale IPv4 address
# (skipped with a warning if Tailscale is not connected). 0.0.0.0 and :: are refused.
HOST=127.0.0.1,tailscale

# Where the agent and CLI on THIS machine reach the gateway.
# GATEWAY_URL=http://127.0.0.1:8787

# --- node agent (per device) ---
# Folders coding sessions may work in, as name=path entries (":" between entries, ";" on Windows).
# Nothing is exposed unless this is set.
# PROJECT_ROOTS=proj=/home/me/code/proj
# Tools coding sessions may run here. Read-only by default.
# ALLOWED_TOOLS=read_file,list_dir,grep
# Answer Claude requests with this device's logged-in `claude` CLI.
# CLAUDE_ENABLED=1
# Let the gateway load and unload models in this device's LM Studio.
# ALLOW_MODEL_CONTROL=1
