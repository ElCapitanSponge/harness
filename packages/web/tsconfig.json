{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@harness/core": ["../core/src/index.ts"],
      "@harness/core/effort": ["../core/src/effort.ts"],
      "@harness/core/image": ["../core/src/image.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", ".storybook/**/*", "vite.config.ts", "vitest.config.ts", "vitest.setup.ts"]
}
