{
  "name": "harness",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "harness": "tsx --env-file-if-exists=.env packages/cli/src/bin.ts",
    "bench": "tsx scripts/bench.ts",
    "gateway": "pnpm --filter @harness/gateway start",
    "agent": "pnpm --filter @harness/node-agent start"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "tsx": "^4.19.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "undici": "^8.12.3",
    "vitest": "^5.0.5"
  }
}
