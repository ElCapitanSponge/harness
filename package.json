{
  "name": "harness",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p packages/web/tsconfig.json",
    "lint": "oxlint && eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:check": "tsx scripts/docs-check.ts",
    "harness": "tsx --env-file-if-exists=.env packages/cli/src/bin.ts",
    "bench": "tsx scripts/bench.ts",
    "gateway": "pnpm --filter @harness/gateway start",
    "agent": "pnpm --filter @harness/node-agent start",
    "build:agent": "tsx scripts/build-agent.ts",
    "agent:run": "node --env-file-if-exists=.env packages/node-agent/dist/agent.mjs",
    "web": "pnpm --filter @harness/web dev",
    "storybook": "pnpm --filter @harness/web storybook",
    "build:web": "pnpm --filter @harness/web build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "esbuild": "0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "oxlint": "^1.90.0",
    "tsx": "^4.19.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "undici": "^8.12.3",
    "vitest": "^5.0.5"
  }
}
